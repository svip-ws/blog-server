# ========== 服务 ==========
PORT=3001
# development / production
NODE_ENV=development

# ========== 数据库 ==========
# 生产环境请为应用创建仅授权本库的专用账号，不要使用 root；口令使用强随机串
DB_HOST=localhost
DB_PORT=3306
DB_USER=blog_app
DB_PASSWORD=请替换为强随机数据库口令
DB_NAME=blog
DB_CONNECTION_LIMIT=10

# ========== JWT ==========
# 生产必填，建议至少 32 位随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=请替换为至少32位随机字符串

# ========== 跨域 ==========
# 允许的前端来源，多个用英文逗号分隔；留空时：生产仅允许同源，开发放行全部
CORS_ORIGINS=https://hxiuji.top,https://www.hxiuji.top

# ========== 大模型（OpenAI 兼容协议） ==========
LLM_PROVIDER=openai
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash-vision-exp
# 真实密钥只写在服务器 .env 中，切勿提交到代码仓库
LLM_API_KEY=请替换为真实密钥

# ========== Gemini（可选） ==========
GEMINI_API_KEY=

# ========== 微信小程序 ==========
WX_APPID=
# 生产环境必须配置；未配置时服务器将禁用微信登录的不安全保底逻辑
WX_SECRET=

# ========== 游客 AI 免费额度（每 24 小时） ==========
# 按设备 guestId 的次数
GUEST_AI_DAILY_LIMIT=2
# 按来源 IP 的总次数（防止不断更换 guestId 绕过）
GUEST_AI_IP_DAILY_LIMIT=30

# ========== 登录用户 AI 额度（每 24 小时，按账号） ==========
USER_AI_DAILY_LIMIT=200
